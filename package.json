    "test:realtime": "node tests/browser-realtime.mjs",
    "build": "vite build"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "qrcode": "^1.5.4",
    "vite": "6.4.4",
    "wlipsync": "1.3.1",
    "ws": "8.21.3",
    "yaml": "^2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  },
  "overrides": {
    "gh-pages": "6.1.1"
  }
