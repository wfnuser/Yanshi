{
  "name": "yanshi",
  "version": "0.1.0",
  "description": "A Live2D voice companion powered by Qwen-Audio-Agent.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wfnuser/Yanshi.git"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=10"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite --host 127.0.0.1 --port 8785 --strictPort",
