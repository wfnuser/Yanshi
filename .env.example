# Path relative to this project (or an absolute path). See docs/setup.md.
QWEN_AUDIO_AGENT_DIR=../_vendor/voice-agents/qwen-audio-agent

# Only required for live conversation; never use a VITE_ prefix for credentials.
DASHSCOPE_API_KEY=
QWEN_AUDIO_REALTIME_PROVIDER=dashscope
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
# QWEN_AUDIO_REALTIME_VOICE=longanqian
# QWEN_AUDIO_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# Optional: explicit proxy or 'off'; otherwise HTTPS_PROXY/system HTTPS proxy.
# AVATAR_HTTPS_PROXY=http://127.0.0.1:7890
